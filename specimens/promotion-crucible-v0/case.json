{
  "case_schema": "promotion-crucible.case/v0",
  "candidate_id": "no-silent-promotion-five-clause-candidate",
  "title": "Projection alone cannot silently constitute evidence, authority, or consequence",
  "promotion_rule": "Frequency is not the threshold. Survival under translation is.",
  "clauses": {
    "epistemic": {
      "statement": "Projection alone does not increase what the underlying evidence identifies.",
      "semantic_fracture": "No fracture is presently observed between the two independent epistemic embodiments.",
      "missing_discriminator": "A third native domain could test whether the same compatible-world constraint survives another observation model."
    },
    "authority": {
      "statement": "Projection alone does not increase warrant, permission, or local authority.",
      "semantic_fracture": "No fracture is presently observed between Free Graph's warrant control and Full Bowl 002's native owner-local authority phase. Full Bowl 001 remains unresolved because its original receipt compresses admission, authority, attempt, and outcome.",
      "missing_discriminator": "A third unrelated native authorization model could test whether representation output remains non-authoritative until its own attributable local gate fires."
    },
    "consequence": {
      "statement": "Projection alone does not constitute a consequential state change; any consequence requires an independently named local gate.",
      "semantic_fracture": "Full Bowl 002 exposes ordered local-authority, attempt, and outcome phases, but FB001-U001 explicitly withholds the genuine warrant and terminal receipt required for same-specimen causal reconciliation. Treating the phase silhouette alone as completed causal proof would silently upgrade its native unresolved state.",
      "missing_discriminator": "Find an existing unrelated system whose native receipt preserves both sides of the same causal chain: representation may inform the system, while a separately attributable decision or commit event demonstrably owns the actual state transition."
    },
    "historical": {
      "statement": "Decoder or lens changes append attributable projections rather than rewriting prior projections.",
      "semantic_fracture": "National Treasure and both Full Bowl receipts lack a native decoder-version succession with an explicit derivation edge. Haunted Toaster separately preserves replayable rasters and immutable receipt bytes, but its existing artifacts do not pair old and new renderings of the same source under two renderer versions.",
      "missing_discriminator": "Find an existing unrelated system with separately addressable old and new renderings of the same source under two interpreter, renderer, or decoder versions, plus native attribution from the new derivation to its prior rendering."
    },
    "identity": {
      "statement": "Representation or lens change does not silently become object or worldline change.",
      "semantic_fracture": "No fracture is presently observed between the view/object control and the independent two-graph identity witness.",
      "missing_discriminator": "A third native domain could test view continuity against an explicit object-transform operation."
    }
  },
